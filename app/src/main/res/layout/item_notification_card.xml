<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/slate_100"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Notification Icon Area -->
        <ImageView
            android:id="@+id/iv_notif_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/info_container"
            android:padding="10dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Notification Title -->
        <TextView
            android:id="@+id/tv_notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            tools:text="Cheque Clearance Reminder"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_notif_badge"
            app:layout_constraintStart_toEndOf="@id/iv_notif_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Invoice / Customer Details -->
        <TextView
            android:id="@+id/tv_notif_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            tools:text="INV-2026-001 | ABC Bakery"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tv_notif_amount"
            app:layout_constraintStart_toEndOf="@id/iv_notif_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_title" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tv_notif_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_cheque"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            tools:text="UPCOMING"
            android:textColor="@color/badge_cheque_text"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Amount -->
        <TextView
            android:id="@+id/tv_notif_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Rs. 12,400.00"
            android:textColor="@color/secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_badge"
            android:layout_marginTop="8dp" />

        <!-- Divider -->
        <View
            android:id="@+id/divider_details"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/slate_100"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_subtitle" />

        <!-- Details Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_details">

            <TextView
                android:id="@+id/tv_notif_cheque_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Cheque Date: 27 May 2026"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_notif_clearance_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Clearance Scheduled: 28 May 2026, 02:30 PM"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
