<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/soft_blue"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Notification Icon Area -->
        <ImageView
            android:id="@+id/iv_notif_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/soft_blue"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/soft_blue_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Notification Title -->
        <TextView
            android:id="@+id/tv_notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Cheque Clearance Reminder"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_notif_badge"
            app:layout_constraintStart_toEndOf="@id/iv_notif_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Invoice / Customer Details -->
        <TextView
            android:id="@+id/tv_notif_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="INV-2026-001 | ABC Bakery"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/tv_notif_amount"
            app:layout_constraintStart_toEndOf="@id/iv_notif_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_title" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tv_notif_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_cheque"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="UPCOMING"
            android:textColor="@color/badge_cheque_text"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Amount -->
        <TextView
            android:id="@+id/tv_notif_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs. 12,400.00"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_badge"
            android:layout_marginTop="4dp" />

        <!-- Divider -->
        <View
            android:id="@+id/divider_details"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E2E8F0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_notif_title"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_subtitle" />

        <!-- Cheque Date -->
        <TextView
            android:id="@+id/tv_notif_cheque_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cheque Date: 27 May 2026"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/divider_details"
            app:layout_constraintTop_toBottomOf="@id/divider_details" />

        <!-- Scheduled Clearance Details -->
        <TextView
            android:id="@+id/tv_notif_clearance_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Clearance Scheduled: 28 May 2026, 02:30 PM"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/divider_details"
            app:layout_constraintTop_toBottomOf="@id/tv_notif_cheque_date" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
