<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/allowed_payment_methods"
        android:textColor="@color/on_surface"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Select one or more payment methods for this customer"
        android:textColor="@color/zinc_500"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/zinc_100" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbCash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="@string/payment_cash"
        android:textColor="@color/on_surface" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/payment_credit"
        android:textColor="@color/on_surface" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbCheque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/payment_cheque"
        android:textColor="@color/on_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackPayment"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/back"
            app:cornerRadius="@dimen/radius_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePayment"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/save"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_sm" />
    </LinearLayout>

</LinearLayout>
