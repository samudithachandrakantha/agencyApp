<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AgencyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/zinc_100</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/info_container</item>
        <item name="colorOnSecondaryContainer">@color/secondary_dark</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background/Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Material 3 Dialog & Component Styling -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AgencyApp.MaterialAlertDialog</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AgencyApp.MediumComponent</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.AgencyApp.HeadlineLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.AgencyApp.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.AgencyApp.BodyLarge</item>
    </style>

    <!-- Rounded Corners for Cards and Dialogs -->
    <style name="ShapeAppearance.AgencyApp.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <!-- Modern Dialog Theme -->
    <style name="ThemeOverlay.AgencyApp.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.AgencyApp.MediumComponent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.AgencyApp.TitleMedium</item>
    </style>

    <style name="Theme.AgencyApp" parent="Base.Theme.AgencyApp" />

    <!-- Typography Styles -->
    <style name="TextAppearance.AgencyApp.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.AgencyApp.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.AgencyApp.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
